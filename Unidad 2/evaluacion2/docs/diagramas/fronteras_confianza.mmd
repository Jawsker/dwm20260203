flowchart TB
    subgraph Z0[Zona 0 · No confiable]
        BR([Navegador / atacante])
        PROV([Proveedor de pagos - sandbox simulado])
    end
    subgraph Z1[Zona 1 · Borde]
        GW[API Gateway<br/>valida sesión, rol, origen, tamaño, límite<br/>descarta cabeceras de identidad del cliente]
        FE[Frontend estático/PHP<br/>sin secretos]
    end
    subgraph Z2[Zona 2 · Servicios privados]
        SV[auth · clients · inventory · orders · payments · graphql<br/>exigen clave de arista; reconfirman rol y propiedad]
    end
    subgraph Z3[Zona 3 · Secretos y datos]
        VA[(Vault)]
        DB[(MongoDB: una base y un usuario por servicio)]
    end
    BR -- "HTTPS + cookie HttpOnly" --> GW
    PROV -- "webhook firmado" --> GW
    GW -- "clave de arista + identidad verificada" --> SV
    SV -- "token propio, política de lectura mínima" --> VA
    SV -- "credencial de BD propia" --> DB
    BR -. "sin ruta" .-x SV
    BR -. "sin ruta" .-x VA
    BR -. "sin ruta" .-x DB
