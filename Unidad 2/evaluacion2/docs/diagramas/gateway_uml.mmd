classDiagram
    direction TB
    class ApiGateway {
        +dispatch(request)
    }
    class RouteDefinition {
        +id : S01..S26
        +method
        +path
        +upstream
        +target
        +auth : none|session
        +roles
        +rate
        +bodyMax
        +forward[]
        +cred : referencia simbólica
    }
    class AuthenticationPolicy {
        +introspect(cookie) Identity
    }
    class AuthorizationPolicy {
        +permitido(role, route)
    }
    class RateLimitPolicy {
        +check(clase, ip)
    }
    class RequestGuardPolicy {
        +limitar tamaño
        +exigir application/json
        +verificar Origin
    }
    class Identity {
        +userId
        +role
    }
    class ServiceTarget {
        +nombre
        +url interna
        +timeout
    }
    class SecretProvider {
        +get(referencia, campo)
        +TTL + último valor conocido
    }
    class FailureMapper {
        +504 timeout
        +503 sin conexión
        +502 error interno
    }
    class AuthService
    class GraphQLGateway {
        <<privado>>
        +query depth 6 · alias 4 · tokens 600
        +sin introspección
    }
    class Schema {
        +Query yo, pedidos, resumenPedido, panelOperacion
        +sin Mutation
    }
    class Resolver {
        +DataLoader por lote
        +propaga Identity
    }
    class ServicioPrivado {
        <<inventory · orders · clients · payments>>
        +exige clave de arista
        +re-verifica rol y propiedad
    }
    ApiGateway "1" o-- "1..*" RouteDefinition : tabla de rutas (26)
    RouteDefinition "0..*" --> "1" AuthorizationPolicy : política de rol
    RouteDefinition "0..*" --> "1" RateLimitPolicy : clase de límite
    RouteDefinition "0..*" --> "1" ServiceTarget : destino
    ApiGateway ..> RequestGuardPolicy
    ApiGateway ..> AuthenticationPolicy
    AuthenticationPolicy ..> AuthService : introspección
    AuthenticationPolicy --> Identity : produce
    ApiGateway ..> SecretProvider : clave de arista por destino
    ApiGateway ..> FailureMapper
    ServiceTarget "1" --> "1" ServicioPrivado : HTTP interno
    ServiceTarget "0..1" --> "1" GraphQLGateway : ruta S20
    GraphQLGateway "1" *-- "1" Schema
    Schema "1" *-- "1..*" Resolver
    Resolver ..> ServicioPrivado : llamadas con Identity
    GraphQLGateway ..> SecretProvider
    ServicioPrivado ..> SecretProvider : sus propias claves
