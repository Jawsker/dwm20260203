classDiagram
    direction TB
    class ApiGateway {
        +dispatch(request)
    }
    class Route {
        +id : S01..S26
        +method
        +path
        +upstream
        +target
        +auth : none|session
        +roles
        +rate
        +bodyMax
        +query[]
        +forward[]
        +identity : bool
        +handler
        +cred : referencia simbólica
    }
    class RouteTable {
        +match(method, path) Route
    }
    class RateLimiter {
        +check(clase, ip)
        ventana deslizante 60 s
    }
    class BodyGuard {
        +limitar tamaño
        +exigir application/json
    }
    class OriginGuard {
        +verificar Origin/Referer
    }
    class SessionResolver {
        +introspect(cookie) Identity
    }
    class Identity {
        +userId
        +role
    }
    class RolePolicy {
        +permitido(role, route)
    }
    class UpstreamClient {
        +araw(servicio, ruta)
        -edgeKey : secreto por arista
        +timeout
    }
    class FailureMapper {
        +504 timeout
        +503 sin conexión
        +502 error interno
    }
    class Handler {
        <<orquestación>>
        register
        login
        logout
        session
        delete_account
    }
    ApiGateway --> RouteTable
    RouteTable "1" o-- "26" Route
    ApiGateway --> RateLimiter
    ApiGateway --> BodyGuard
    ApiGateway --> OriginGuard
    ApiGateway --> SessionResolver
    SessionResolver --> Identity
    ApiGateway --> RolePolicy
    RolePolicy ..> Identity
    ApiGateway --> UpstreamClient
    UpstreamClient --> FailureMapper
    ApiGateway --> Handler
    Handler --> UpstreamClient
